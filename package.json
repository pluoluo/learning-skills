{
  "name": "learning-skills",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Portable teaching skills and interactive learning artifacts for AI agents",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "example:build": "node skills/interactive-topic-lesson/scripts/build.mjs examples/perimeter-area/lesson.json --out dist/perimeter-area",
    "example:check": "node skills/interactive-topic-lesson/scripts/validate.mjs examples/perimeter-area/lesson.json",
    "test:responsive": "node tests/responsive.cdp.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "license": "MIT"
}
